{
  "$defs": {
    "ImageCapabilities": {
      "additionalProperties": false,
      "properties": {
        "max_images": {
          "maximum": 10,
          "minimum": 1,
          "title": "Max Images",
          "type": "integer"
        },
        "external_urls": {
          "default": false,
          "title": "External Urls",
          "type": "boolean"
        },
        "proxied_urls": {
          "default": false,
          "title": "Proxied Urls",
          "type": "boolean"
        }
      },
      "required": [
        "max_images"
      ],
      "title": "ImageCapabilities",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What a renderer can present. Declarations never grant trust, proof, consent or grants.",
  "properties": {
    "contract_version": {
      "title": "Contract Version",
      "type": "string"
    },
    "max_batch_items": {
      "default": 1,
      "maximum": 50,
      "minimum": 1,
      "title": "Max Batch Items",
      "type": "integer"
    },
    "message_updates": {
      "default": "none",
      "enum": [
        "none",
        "edit",
        "replace"
      ],
      "title": "Message Updates",
      "type": "string"
    },
    "threaded_follow_ups": {
      "default": false,
      "title": "Threaded Follow Ups",
      "type": "boolean"
    },
    "text_formats": {
      "default": [
        "plain"
      ],
      "items": {
        "enum": [
          "plain",
          "markdown",
          "html_email"
        ],
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Text Formats",
      "type": "array"
    },
    "rich_embeds": {
      "default": false,
      "title": "Rich Embeds",
      "type": "boolean"
    },
    "images": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImageCapabilities"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "action_buttons": {
      "default": 0,
      "maximum": 10,
      "minimum": 0,
      "title": "Action Buttons",
      "type": "integer"
    },
    "links": {
      "default": false,
      "title": "Links",
      "type": "boolean"
    },
    "live_page_links": {
      "default": false,
      "title": "Live Page Links",
      "type": "boolean"
    },
    "max_title_chars": {
      "default": 500,
      "maximum": 500,
      "minimum": 16,
      "title": "Max Title Chars",
      "type": "integer"
    },
    "max_text_chars": {
      "default": 10000,
      "maximum": 100000,
      "minimum": 64,
      "title": "Max Text Chars",
      "type": "integer"
    },
    "max_payload_bytes": {
      "default": 65536,
      "maximum": 10485760,
      "minimum": 1024,
      "title": "Max Payload Bytes",
      "type": "integer"
    }
  },
  "required": [
    "contract_version"
  ],
  "title": "NotificationProviderCapabilities",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-notification-contract-version": "1.0.0"
}
